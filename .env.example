# Google OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Must exactly match an Authorized redirect URI in Google Cloud OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Any long random string for session signing
SESSION_SECRET=change-this-to-a-long-random-string
AGENT_API_KEY=change-this-to-a-long-random-agent-api-key
GOOGLE_TOKEN_ENCRYPTION_SECRET=change-this-to-a-separate-token-encryption-secret

PORT=3000

# MongoDB Atlas connection
MONGODB_URI=mongodb://username:password@cluster-host-1:27017,cluster-host-2:27017,cluster-host-3:27017/?ssl=true&replicaSet=your-replica-set&authSource=admin&retryWrites=true&w=majority
# Optional: if not set, app uses DB from URI path; if none, defaults to "test".
MONGODB_DB_NAME=google_calendar_viewer_vmdw

# Local Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_TIMEOUT_MS=60000
CHAT_USE_LLM_INTENT=false
CHAT_USE_LLM_REPLY=false
CHAT_USE_LLM_SEMANTIC_FALLBACK=false

# n8n chatbot workflow integration
N8N_CHAT_ENABLED=true
N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.example/webhook/calendar-chatbot
N8N_CHAT_TIMEOUT_MS=60000
N8N_CHAT_API_KEY=
